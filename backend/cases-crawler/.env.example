# LexPrime Cases Crawler - 环境变量配置示例
# 复制为 .env 并填入真实值
# cp .env.example .env

# ====== Database ======
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=lexprime
POSTGRES_USER=lexprime
POSTGRES_PASSWORD=lexprime_dev_pwd
DATABASE_URL=postgresql+asyncpg://lexprime:lexprime_dev_pwd@localhost:5432/lexprime

# ====== Elasticsearch ======
ES_HOST=localhost
ES_PORT=9200
ES_SCHEME=http
ES_USER=elastic
ES_PASSWORD=elastic_dev_pwd
ES_INDEX_CASES=cases
ES_INDEX_LAWS=laws
ES_INDEX_COMPANIES=companies

# ====== Neo4j (股权穿透图) ======
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=neo4j_dev_pwd

# ====== 4 个免费数据源 ======
# 国家法律法规数据库 (国务院)
NPC_LAWS_BASE_URL=https://flk.npc.gov.cn
NPC_LAWS_API_URL=https://flk.npc.gov.cn/api/

# 人民法院案例库 (最高法 2024 重启)
COURT_CASES_BASE_URL=https://rmfyalk.court.gov.cn
COURT_CASES_API_URL=https://rmfyalk.court.gov.cn/api/

# 中国执行信息公开网 (最高法)
ZHIXING_BASE_URL=https://zxgk.court.gov.cn

# 国家企业信用信息公示系统 (国家市场监督管理总局)
GSXT_BASE_URL=https://www.gsxt.gov.cn
GSXT_API_URL=https://www.gsxt.gov.cn/api/

# ====== cncases 数据源 ======
# cncases/cases 仓库的原始数据 (CSV inside ZIP, 102GB)
# 下载: https://github.com/cncases/cases/releases (BT 种子)
CNCASES_RAW_PATH=./data/raw/cncases
CNCASES_BATCH_SIZE=5000

# ====== 爬虫配置 ======
CRAWLER_CONCURRENT=10          # 并发数
CRAWLER_DELAY_MS=1000          # 每次请求间隔 (ms)
CRAWLER_TIMEOUT=30             # 超时 (秒)
CRAWLER_MAX_RETRIES=3          # 最大重试
CRAWLER_USER_AGENT=Mozilla/5.0 (LexPrime Bot; +https://lexprime.com/bot)

# 代理池 (可选, 启动反爬时启用)
PROXY_ENABLED=false
PROXY_POOL=http://user:pass@proxy1:8080,http://user:pass@proxy2:8080

# ====== API ======
API_HOST=0.0.0.0
API_PORT=8000
API_DEBUG=true
API_CORS_ORIGINS=http://localhost:8080,http://127.0.0.1:8080

# ====== 日志 ======
LOG_LEVEL=INFO
LOG_FILE=./logs/crawler.log
