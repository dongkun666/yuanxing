{
  "$schema": "https://agentskills.io/schemas/skill-manifest.v1.json",
  "id": "lexprime.skill.caselaw",
  "name": "类案检索与裁判参考",
  "version": "0.1.0-draft",
  "status": "draft",
  "owner_agent": "lex-ai",
  "reviewer_agent": "lex-pm",
  "lawyer_review_required": true,
  "description": {
    "zh": "在已公开裁判文书中检索与当前案件相似的判例, 输出支持率统计 / 判赔金额参考 / 主要争议焦点 / 法官审理风格, **仅呈现统计数据, 不做任何确定性判断或预测**。",
    "en": "Retrieve similar published judgments to the current case, output aggregate statistics (support rate / award range / dispute focus / judge style). Displays only statistics — never makes deterministic predictions."
  },
  "category": "research",
  "tags": ["case-retrieval", "judgment-reference", "statistics-only", "neutral-language"],
  "entrypoint": "skill:main",
  "runtime": {
    "model": {
      "primary": "qwen2.5:7b",
      "fallback": ["qwen2.5:14b", "qwen2.5:72b"]
    },
    "embedding": {
      "primary": "BAAI/bge-small-zh-v1.5",
      "fallback": "BAAI/bge-large-zh-v1.5",
      "vector_store": "lancedb",
      "vector_store_fallback": "milvus"
    },
    "context_window": 8000,
    "context_strategy": "trajectory_compression",
    "load_strategy": "lazy",
    "load_timeout_ms": 3000
  },
  "inputs": {
    "schema_file": "schemas/input.json",
    "example_file": "schemas/input.example.json"
  },
  "outputs": {
    "schema_file": "schemas/output.json",
    "example_file": "schemas/output.example.json"
  },
  "prompt_files": [
    "prompt.md",
    "language_policy.md"
  ],
  "permissions": {
    "read": ["cases", "laws"],
    "write": [],
    "network": "offline-only",
    "external_apis": []
  },
  "compliance": {
    "language_policy": "neutral-only",
    "disclaimer_required": true,
    "disclaimer_text_file": "disclaimer.md",
    "forbidden_phrases_check": "tests/test_language_guard.py",
    "data_sources": ["cncases", "court_cases", "lawyer_added_cases"],
    "min_lawyer_reviewers": 3,
    "accuracy_target": 0.80
  },
  "dependencies": {
    "lexprime_module": ">=0.7.0",
    "python_packages": ["lancedb>=0.6", "sentence-transformers>=2.7", "pydantic>=2.9", "tiktoken>=0.7"]
  },
  "metrics": {
    "p95_latency_ms_target": 1000,
    "load_time_ms_target": 3000,
    "accuracy_target": 0.80,
    "false_statement_rate_target": 0.0
  },
  "tracked_references": ["T-REF-17", "T-REF-18", "T-REF-22", "T-REF-25"],
  "tracks": ["E-skills"],
  "created_at": "2026-06-29",
  "updated_at": "2026-06-29"
}