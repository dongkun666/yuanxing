# W14 first-paid-triggers-729 SMTP 凭证模板
# W15 w14-followup-fixes (lex-coder · 2026-06-30)
#
# 使用说明:
#   1. cp scripts/smtp-credentials.env.example scripts/smtp-credentials.env
#   2. 编辑 scripts/smtp-credentials.env 填实 5 个变量 (公测前 7/22 总指挥填实)
#   3. .gitignore 已排除 scripts/smtp-credentials.env (不会 commit 真实凭证)
#   4. send_email.py 启动时自动 load_dotenv(smtp-credentials.env)
#
# 推荐 SMTP 服务 (国内触达率排序):
#   - QQ 企业邮箱 (exmail.qq.com) — 默认推荐, 5/天免费, 适合个人版
#   - 阿里云邮箱 (mail.aliyun.com) — 50/天免费, 适合中小律所
#   - SendGrid / Mailgun — 海外服务, 国内触达率不稳定
#
# 安全规范:
#   - 不要 commit 本文件 (真实凭证), .gitignore 已排除
#   - 不要在 issue / PR / 文档里写明文密码
#   - 公测期建议使用 app-specific password (不是登录密码)
#   - 触发器失败 → 自动 fallback 到飞书/微信 1v1 触达

# === SMTP 服务器 ===
SMTP_HOST=smtp.exmail.qq.com
SMTP_PORT=465

# === 认证凭证 ===
SMTP_USER=founder@lexprime.cn
SMTP_PASSWORD=<公测前 7/22 总指挥填实 - QQ 企业邮箱 app-specific password>

# === 发件人 ===
FROM_EMAIL=founder@lexprime.cn
FROM_NAME=LexPrime 创始人

# === 可选: TLS / 重试策略 ===
SMTP_USE_TLS=true
SMTP_MAX_RETRIES=3
SMTP_TIMEOUT_SEC=30