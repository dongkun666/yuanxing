.container {
  padding: 0;
  padding-bottom: 40rpx;
}

.profile-header {
  background: linear-gradient(135deg, #1e40af 0%, #3b82f6 100%);
  padding: 60rpx 32rpx 40rpx;
  color: #ffffff;
}

.user-section {
  display: flex;
  align-items: center;
  gap: 24rpx;
}

.avatar {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  border: 4rpx solid rgba(255, 255, 255, 0.3);
}

.avatar-placeholder {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.2);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 48rpx;
}

.user-info {
  flex: 1;
}

.user-name {
  display: block;
  font-size: 36rpx;
  font-weight: 600;
  margin-bottom: 8rpx;
}

.user-email,
.user-subtitle {
  display: block;
  font-size: 26rpx;
  opacity: 0.8;
}

.arrow {
  font-size: 40rpx;
  opacity: 0.6;
}

.stats-row {
  display: flex;
  align-items: center;
  justify-content: space-around;
  margin-top: 40rpx;
  padding-top: 32rpx;
  border-top: 1rpx solid rgba(255, 255, 255, 0.2);
}

.stat-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
}

.stat-number {
  font-size: 40rpx;
  font-weight: 700;
}

.stat-label {
  font-size: 24rpx;
  opacity: 0.8;
}

.stat-divider {
  width: 1rpx;
  height: 60rpx;
  background: rgba(255, 255, 255, 0.2);
}

.menu-section {
  padding: 24rpx;
}

.group-title {
  display: block;
  font-size: 26rpx;
  color: #64748b;
  margin-bottom: 16rpx;
  padding-left: 8rpx;
}

.menu-list {
  padding: 0;
  overflow: hidden;
  margin-bottom: 0;
}

.menu-item {
  display: flex;
  align-items: center;
  padding: 28rpx 24rpx;
  border-bottom: 1rpx solid #f1f5f9;
}

.menu-item:last-child {
  border-bottom: none;
}

.menu-icon {
  font-size: 36rpx;
  margin-right: 20rpx;
}

.menu-label {
  flex: 1;
  font-size: 28rpx;
  color: #1e293b;
}

.menu-arrow {
  font-size: 32rpx;
  color: #cbd5e1;
}

.logout-section {
  padding: 40rpx 24rpx;
}

.logout-btn {
  width: 100%;
  background: #ffffff;
  color: #ef4444;
  border-radius: 16rpx;
  font-size: 30rpx;
  font-weight: 500;
}

.logout-btn::after {
  border: none;
}

.footer {
  text-align: center;
  padding: 40rpx 0 20rpx;
}

.version {
  font-size: 24rpx;
  color: #94a3b8;
}
