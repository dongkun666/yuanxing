.input-section {
  margin-top: 24rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #1e293b;
  margin-bottom: 24rpx;
}

.form-item {
  margin-bottom: 24rpx;
}

.form-label {
  display: block;
  font-size: 28rpx;
  color: #475569;
  margin-bottom: 12rpx;
}

.picker-value {
  background: #f8fafc;
  border: 1rpx solid #e2e8f0;
  border-radius: 12rpx;
  padding: 24rpx;
  font-size: 28rpx;
  color: #1e293b;
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.picker-arrow {
  font-size: 24rpx;
  color: #94a3b8;
}

.contract-textarea {
  width: 100%;
  min-height: 300rpx;
  background: #f8fafc;
  border: 1rpx solid #e2e8f0;
  border-radius: 12rpx;
  padding: 24rpx;
  font-size: 28rpx;
  color: #1e293b;
  line-height: 1.6;
  box-sizing: border-box;
}

.upload-buttons {
  display: flex;
  gap: 24rpx;
  margin-top: 24rpx;
}

.upload-btn {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 32rpx;
  background: #f8fafc;
  border: 2rpx dashed #cbd5e1;
  border-radius: 16rpx;
  gap: 12rpx;
}

.upload-icon {
  font-size: 48rpx;
}

.upload-text {
  font-size: 26rpx;
  color: #64748b;
}

.submit-btn {
  margin-top: 32rpx;
  width: 100%;
}

.result-section {
  padding-bottom: 40rpx;
}

.result-header {
  margin-top: 24rpx;
}

.result-title-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 12rpx;
}

.result-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #1e293b;
}

.score-badge {
  text-align: center;
}

.score-badge .score-label {
  display: block;
  font-size: 22rpx;
  color: #94a3b8;
  margin-bottom: 4rpx;
}

.score-badge .score-value {
  font-size: 36rpx;
  font-weight: 700;
  color: #ef4444;
}

.result-subtitle {
  font-size: 26rpx;
  color: #64748b;
}

.summary-section {
  margin-top: 24rpx;
}

.summary-text {
  font-size: 28rpx;
  color: #475569;
  line-height: 1.7;
}

.risks-section {
  margin-top: 24rpx;
}

.section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 0 24rpx;
  margin-bottom: 16rpx;
}

.section-header .section-title {
  margin-bottom: 0;
}

.risk-count {
  font-size: 26rpx;
  color: #64748b;
}

.risk-item {
  margin: 0 24rpx 20rpx;
  margin-bottom: 20rpx;
}

.risk-header {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 12rpx;
}

.risk-level {
  flex-shrink: 0;
}

.risk-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #1e293b;
  flex: 1;
}

.risk-desc {
  font-size: 26rpx;
  color: #64748b;
  line-height: 1.6;
}

.action-buttons {
  display: flex;
  gap: 24rpx;
  padding: 24rpx;
}

.action-buttons button {
  flex: 1;
}
