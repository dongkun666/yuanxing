.container {
  min-height: 100vh;
  padding: 80rpx 48rpx 40rpx;
  box-sizing: border-box;
  background: #ffffff;
}

.logo-section {
  text-align: center;
  margin-bottom: 80rpx;
}

.logo {
  font-size: 120rpx;
  margin-bottom: 24rpx;
}

.app-name {
  display: block;
  font-size: 48rpx;
  font-weight: 700;
  color: #1e40af;
  margin-bottom: 12rpx;
}

.app-slogan {
  font-size: 28rpx;
  color: #64748b;
}

.login-section {
  margin-bottom: 48rpx;
}

.form-group {
  margin-bottom: 32rpx;
}

.form-input {
  width: 100%;
  height: 96rpx;
  padding: 0 32rpx;
  background: #f8fafc;
  border: 1rpx solid #e2e8f0;
  border-radius: 16rpx;
  font-size: 30rpx;
  color: #1e293b;
  box-sizing: border-box;
}

.forgot-password {
  text-align: right;
  margin-bottom: 32rpx;
}

.link {
  color: #1e40af;
  font-size: 26rpx;
}

.login-btn {
  width: 100%;
  height: 96rpx;
  line-height: 96rpx;
  font-size: 32rpx;
  border-radius: 16rpx;
}

.divider-text {
  display: flex;
  align-items: center;
  margin: 48rpx 0;
}

.divider-line {
  flex: 1;
  height: 1rpx;
  background: #e2e8f0;
}

.divider-label {
  padding: 0 24rpx;
  font-size: 26rpx;
  color: #94a3b8;
}

.wx-login-btn {
  width: 100%;
  height: 96rpx;
  line-height: 96rpx;
  font-size: 30rpx;
  border-radius: 16rpx;
  background: #07c160;
  color: #ffffff;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
}

.wx-login-btn::after {
  border: none;
}

.wx-icon {
  font-size: 36rpx;
}

.terms-section {
  margin-bottom: 40rpx;
}

.checkbox-row {
  display: flex;
  align-items: flex-start;
  gap: 16rpx;
}

.checkbox {
  width: 36rpx;
  height: 36rpx;
  border: 2rpx solid #cbd5e1;
  border-radius: 8rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  color: #ffffff;
  flex-shrink: 0;
  margin-top: 4rpx;
}

.checkbox.checked {
  background: #1e40af;
  border-color: #1e40af;
}

.terms-text {
  flex: 1;
  font-size: 26rpx;
  color: #64748b;
  line-height: 1.6;
}

.register-section {
  text-align: center;
  font-size: 28rpx;
  color: #64748b;
}

.register-section .link {
  font-size: 28rpx;
  margin-left: 8rpx;
}
